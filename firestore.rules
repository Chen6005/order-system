rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 1 security rules:
    // Customers can create orders without signing in.
    // Signed-in users can read and update orders.
    // This does not include a real admin role yet.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if request.auth != null;
      allow delete: if false;
    }

    // Phase 1 menu item rules:
    // Anyone can read menu items.
    // Signed-in users can create and update menu items for MVP operations.
    // This will be upgraded to a real admin role later.
    match /menuItems/{menuItemId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
